# Browserbase session used by Stagehand to read source pages.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ElevenLabs text-to-speech. Leave blank to use the in-browser sample voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Groq OpenAI-compatible chat completions.
# Default model: llama-3.3-70b-versatile
# Endpoint: https://api.groq.com/openai/v1/chat/completions
OPEN_AI_OR_GROQ_API_KEY=
